+  it("should get recipe ingredients mapped to products", async () => {
+    const results = await client.searchRecipes("pizza");
+    const recipe = await client.getRecipeIngredients(results.items[0].id);
+    expect(recipe.default_portions).toBeGreaterThan(0);
