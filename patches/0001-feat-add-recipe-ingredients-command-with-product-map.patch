diff --git a/src/types.ts b/src/types.ts
index da3b367..6a7c31f 100644
--- a/src/types.ts
+++ b/src/types.ts
@@ -71,6 +71,43 @@ export interface RecipePage {
   has_more: boolean;
 }
 
+export interface RecipeIngredientProduct {
+  id: number;
+  name: string;
+  full_name: string;
+  name_extra: string;
+  price: number;
+  available: boolean;
+}
+
+/** One ingredient line with the Oda product it maps to. */
+export interface RecipeIngredient {
+  /** Oda's canonical ingredient ID (e.g. 50 = "Gul løk"), shared across recipes. */
+  ingredient_id: number | null;
+  title: string;
+  /** Oda marks pantry staples (salt, oil, spices) as "basic". */
+  is_basic: boolean;
+  /** Product packages needed per portion — what Oda itself multiplies by portions for the cart. */
+  packages_per_portion: number;
+  /** Human quantity for the recipe's default portions, e.g. 400 g. */
+  display_quantity: number;
+  display_unit: string;
+  group: string;
+  product: RecipeIngredientProduct | null;
+}
+
+/** Machine-readable recipe: product-mapped ingredients for planning across recipes. */
+export interface RecipeIngredients {
+  id: number;
+  name: string;
+  default_portions: number;
+  duration: string;
+  difficulty: string;
+  tags: { id: number; title: string; group: string | null }[];
+  url: string;
+  ingredients: RecipeIngredient[];
+}
+
 export interface RecipeDetail {
   name: string;
   description: string;
